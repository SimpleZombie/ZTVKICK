# ZTV 24/7 stream settings. This file lives at /etc/ztv/stream.env on the server.
# After editing:  sudo systemctl restart ztv-stream

# From kick.com > Creator Dashboard > Settings > Stream URL & Key. Copy both exactly.
# Keep the key secret. If it ever shows up on screen, reset it on Kick and paste the new one here.
KICK_URL=
KICK_KEY=

# Picture. 1280x720 at 2500 kbps is plenty for VHS-era archive video and leaves headroom on busy networks.
# For 1080p use WIDTH=1920 HEIGHT=1080 VIDEO_KBPS=6000 (needs more CPU, watch it with "top").
WIDTH=1280
HEIGHT=720
FPS=30
VIDEO_KBPS=2500
AUDIO_KBPS=160
